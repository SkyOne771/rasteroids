[Unit]
Description=Back up the Rasteroids SQLite database
After=rasteroids.service

[Service]
Type=oneshot
User=rasteroids
Group=rasteroids
ExecStart=/usr/bin/python3 /opt/rasteroids/deploy/backup.py --database /var/lib/rasteroids/rasteroids.sqlite3 --directory /var/backups/rasteroids --keep 7
ReadWritePaths=/var/backups/rasteroids /var/lib/rasteroids
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
